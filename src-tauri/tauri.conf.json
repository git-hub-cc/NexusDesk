{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexusDesk",
  "mainBinaryName": "NexusDesk",
  "version": "0.1.1",
  "identifier": "com.user.nexusdesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NexusDesk",
        "create": false,
        "visible": false,
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "decorations": false,
        "dragDropEnabled": false,
        "devtools": true,
        "backgroundColor": [
          43,
          45,
          48,
          255
        ]
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "wix": {
        "template": "installer.wxs"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh",
        "template": "installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ocr/*": "resources/ocr/",
      "resources/runtime/DirectML.dll": "DirectML.dll",
      "resources/stt-runtime/*.dll": "",
      "resources/runtime/DirectML-LICENSE.txt": "DirectML-LICENSE.txt"
    }
  }
}
